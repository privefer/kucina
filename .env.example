# Kucina Environment Configuration Template
# Copy this file to kucina_backend/.env before starting the server

PORT=3000
NODE_ENV=development
JWT_SECRET=change_this_to_a_secure_jwt_secret_key_in_production
JWT_REFRESH_SECRET=change_this_to_a_secure_refresh_secret_key_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
